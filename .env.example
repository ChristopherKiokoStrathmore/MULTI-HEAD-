# Base URL of the deployed model API. No trailing slash.
# The app calls {NEXT_PUBLIC_API_URL}/health, /predict and /predict_batch.
# Do NOT append /predict (or any other path) to this value.
#
# Local development: copy this file to .env.local and fill in the real URL.
# Vercel: set the same key in Project -> Settings -> Environment Variables,
# then redeploy. NEXT_PUBLIC_* values are inlined at BUILD time.
#
# Shape: https://your-model-api.example.com
NEXT_PUBLIC_API_URL=https://your-model-api.example.com
#
# Eval harness only (not read by the Next.js app):
# MULTIHEAD_API_URL=https://thechriskioko--threehead-serve-server-fastapi-app.modal.run
